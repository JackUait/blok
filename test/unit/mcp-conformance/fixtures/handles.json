{
  "description": "Handle lifetime: idle expiry (--handle-idle-ms), the per-principal cap after an expiry, and a handle whose access was taken away. The sweep runs every min(idle, 30 s), so cases sleep several sweeps past the cutoff, never near it.",
  "defaults": {
    "transport": "stdio",
    "argv": [
      "--source",
      "files:${dir}"
    ],
    "files": {
      "doc.json": {
        "json": {
          "title": "Notes",
          "blocks": [
            {
              "id": "p1",
              "type": "paragraph",
              "data": {
                "text": "Hello"
              }
            }
          ]
        }
      },
      "other.json": {
        "json": {
          "blocks": []
        }
      }
    },
    "session": {
      "protocolVersion": "2025-11-25"
    },
    "maskKeys": [
      "lastEditedAt",
      "savedVersion",
      "revision"
    ]
  },
  "cases": [
    {
      "argv": [
        "--source",
        "files:${dir}",
        "--handle-idle-ms",
        "300"
      ],
      "name": "an idle handle expires: read and close then answer UNKNOWN_HANDLE",
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": true
              }
            }
          },
          "capture": {
            "handle": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${handle}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 300,
                "contractRevision": "ace641df",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "sleepMs": 1500
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_read",
              "arguments": {
                "handle": "${handle}"
              }
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "UNKNOWN_HANDLE",
                  "message": "No open document has this handle. It may have expired; call blok_open again.",
                  "retryable": false
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          }
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_close",
              "arguments": {
                "handle": "${handle}"
              }
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "UNKNOWN_HANDLE",
                  "message": "No open document has this handle. It may have expired; call blok_open again.",
                  "retryable": false
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 3
          }
        }
      ],
      "expectExit": {
        "code": 0
      }
    },
    {
      "argv": [
        "--source",
        "files:${dir}",
        "--handle-idle-ms",
        "300",
        "--max-handles",
        "1"
      ],
      "name": "an expired handle frees its place under --max-handles",
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": true
              }
            }
          },
          "capture": {
            "handle": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${handle}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 300,
                "contractRevision": "ace641df",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "other",
                "write": true
              }
            }
          },
          "capture": {
            "second": {
              "pointer": "/result/structuredContent/handle",
              "optional": true
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "HANDLE_LIMIT",
                  "message": "You already have 1 open documents. Close one with blok_close.",
                  "retryable": true
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          }
        },
        {
          "sleepMs": 1500
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "other",
                "write": true
              }
            }
          },
          "capture": {
            "third": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${third}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 300,
                "contractRevision": "ace641df",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 3
          }
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_read",
              "arguments": {
                "handle": "${third}"
              }
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "revision": "<masked>",
                "rootId": null,
                "blocks": []
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 4
          }
        }
      ],
      "expectExit": {
        "code": 0
      }
    },
