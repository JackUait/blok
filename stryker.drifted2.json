{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.drifted.config.ts"
  },
  "incremental": false,
  "incrementalFile": ".mutation-state/stryker-incremental-drifted.json",
  "ignoreStatic": true,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "dryRunTimeoutMinutes": 240,
  "concurrency": 4,
  "reporters": [
    "clear-text",
    "json"
  ],
  "htmlReporter": {
    "fileName": ".mutation-state/report-drifted.html"
  },
  "jsonReporter": {
    "fileName": ".mutation-state/report-drifted-2.json"
  },
  "ignorePatterns": [
    "docs/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    ".server-test-results/**",
    ".server-coverage/**",
    "static/**",
    "public/**",
    "packages/server/dotnet/**",
    ".playwright-cli/**",
    ".playwright-mcp/**",
    ".venv/**",
    ".dev/**",
    "override-extension/**",
    "*.png",
    "*.json.gz"
  ],
  "mutate": [
    "src/components/modules/collaboration/presence.ts",
    "src/components/modules/collaboration/provider.ts",
    "src/components/modules/collaboration/sync-wire.ts",
    "src/components/shared/block-color.ts",
    "src/components/shared/color-picker.ts",
    "src/components/utils/popover/popover-inline.ts",
    "src/components/utils/popover/popover-mobile.ts",
    "src/components/utils/tooltip.ts",
    "src/tools/image/uploading-state.ts",
    "src/tools/table/table-cell-selection.ts",
    "src/tools/toggle/constants.ts",
    "src/tools/video/controls.ts"
  ]
}
