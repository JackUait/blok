            "args": {
              "id": "p",
              "with": "Two"
            }
          }
        ]
      },
      "expect": {
        "ok": true,
        "state": {
          "/blocks/0/lastEditedBy": "agent-cs"
        }
      }
    },
    {
      "run": "room",
      "actor": {
        "id": "agent-cs",
        "name": "Agent"
      },
      "batch": {
