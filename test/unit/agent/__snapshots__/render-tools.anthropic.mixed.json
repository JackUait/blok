[
  {
    "name": "blok_read",
    "description": "Read the document as a tree of blocks with ids, types and text. Read before you edit, and again after a STALE error.",
    "input_schema": {
      "type": "object",
      "properties": {
        "rootId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "A block id, or \"$ref\" of a block an earlier command created."
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A block id, or \"$ref\" of a block an earlier command created."
          }
        },
        "detail": {
          "enum": [
            "outline",
            "full"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        },
        "textLimit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "blok_describe",
    "description": "Look up what you can do. With no arguments it lists tools and commands. Pass { tool } or { command } to get the argument schema.",
    "input_schema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "blok_execute",
    "description": "Run a batch of commands. Either all of them land or none do. Use block ids from blok_read. The schema has the full arguments for block.delete, block.insert, markdown.insert, text.replace. Call blok_describe for any other command's arguments.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.delete"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A block id, or \"$ref\" of a block an earlier command created."
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.insert"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "data": {
                        "type": "object"
                      },
                      "tunes": {
                        "type": "object"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "children": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/block_insert__insertSpec"
                        }
                      },
                      "parentId": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "description": "A block id, or \"$ref\" of a block an earlier command created."
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "position": {
                        "description": "'start' | 'end' | { before: id } | { after: id }",
                        "oneOf": [
                          {
                            "enum": [
                              "start",
                              "end"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "before": {
                                "type": "string",
                                "minLength": 1,
                                "description": "A block id, or \"$ref\" of a block an earlier command created."
                              }
                            },
                            "required": [
                              "before"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "after": {
                                "type": "string",
                                "minLength": 1,
                                "description": "A block id, or \"$ref\" of a block an earlier command created."
                              }
                            },
                            "required": [
                              "after"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "demote": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "markdown.insert"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "markdown": {
                        "type": "string"
                      },
                      "parentId": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "description": "A block id, or \"$ref\" of a block an earlier command created."
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "position": {
                        "description": "'start' | 'end' | { before: id } | { after: id }",
                        "oneOf": [
                          {
                            "enum": [
                              "start",
                              "end"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "before": {
                                "type": "string",
                                "minLength": 1,
                                "description": "A block id, or \"$ref\" of a block an earlier command created."
                              }
                            },
                            "required": [
                              "before"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "after": {
                                "type": "string",
                                "minLength": 1,
                                "description": "A block id, or \"$ref\" of a block an earlier command created."
                              }
                            },
                            "required": [
                              "after"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "markdown"
                    ],
                    "additionalProperties": false
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "text.replace"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A block id, or \"$ref\" of a block an earlier command created."
                      },
                      "field": {
                        "type": "string"
                      },
                      "range": {
                        "oneOf": [
                          {
                            "const": "all"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "expectText": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "find": {
                                "type": "string",
                                "minLength": 1
                              },
                              "occurrence": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "required": [
                              "find"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "with": {
                        "description": "Plain text, or rich-text segments. Never Markdown.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "with"
                    ],
                    "additionalProperties": false
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "audio.setCover",
                      "audio.setSource",
                      "block.convert",
                      "block.duplicate",
                      "block.move",
                      "block.update",
                      "column_list.addColumn",
                      "column_list.create",
                      "column_list.removeColumn",
                      "column_list.setWidths",
                      "database.addOption",
                      "database.addProperty",
                      "database.addRow",
                      "database.addTemplate",
                      "database.addView",
                      "database.changePropertyType",
                      "database.create",
                      "database.deleteOption",
                      "database.deleteProperty",
                      "database.deleteView",
                      "database.duplicateProperty",
                      "database.duplicateView",
                      "database.moveOption",
                      "database.moveRow",
                      "database.moveView",
                      "database.recolorOption",
                      "database.renameOption",
                      "database.renameView",
                      "database.setDefaultTemplate",
                      "database.setRowValues",
                      "database.setTemplateRepeat",
                      "database.updateProperty",
                      "doc.find",
                      "doc.read",
                      "doc.setIcon",
                      "doc.setTitle",
                      "embed.setUrl",
                      "file.setSource",
                      "history.redo",
                      "history.undo",
                      "image.addMarkup",
                      "image.crop",
                      "image.flip",
                      "image.removeMarkup",
                      "image.rotate",
                      "image.setSource",
                      "image.straighten",
                      "image.updateMarkup",
                      "markdown.export",
                      "rating.setValue",
                      "table.clearCells",
                      "table.create",
                      "table.deleteColumns",
                      "table.deleteRows",
                      "table.duplicateColumns",
                      "table.duplicateRows",
                      "table.fillCells",
                      "table.insertColumns",
                      "table.insertRows",
                      "table.mergeCells",
                      "table.moveColumn",
                      "table.moveRow",
                      "table.splitCell",
                      "table.styleCells",
                      "tabs.addTab",
                      "tabs.create",
                      "tabs.deleteTab",
                      "text.delete",
                      "text.format",
                      "text.insert",
                      "video.setSource"
                    ]
                  },
                  "args": {
                    "type": "object"
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ]
              }
            ]
          }
        },
        "expectRevision": {
          "type": "string"
        }
      },
      "required": [
        "commands"
      ],
      "$defs": {
        "block_insert__insertSpec": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "object"
            },
            "tunes": {
              "type": "object"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block_insert__insertSpec"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      }
    }
  }
]