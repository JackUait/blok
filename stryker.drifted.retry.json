{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.drifted.config.ts"
  },
  "incremental": false,
  "incrementalFile": ".mutation-state/stryker-incremental-drifted.json",
  "ignoreStatic": true,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "dryRunTimeoutMinutes": 240,
  "concurrency": 4,
  "reporters": [
    "clear-text",
    "json"
  ],
  "htmlReporter": {
    "fileName": ".mutation-state/report-drifted.html"
  },
  "jsonReporter": {
    "fileName": ".mutation-state/report-drifted.json"
  },
  "ignorePatterns": [
    "docs/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    ".server-test-results/**",
    ".server-coverage/**",
    "static/**",
    "public/**",
    "packages/server/dotnet/**",
    ".playwright-cli/**",
    ".playwright-mcp/**",
    ".venv/**",
    ".dev/**",
    "override-extension/**",
    "*.png",
    "*.json.gz"
  ],
  "mutate": [
    "src/blok.ts",
    "src/components/block/api.ts",
    "src/components/blocks.ts",
    "src/components/core.ts",
    "src/components/events/CollaborationStatusChanged.ts",
    "src/components/inline-tools/inline-tool-convert.ts",
    "src/components/inline-tools/inline-tool-link.ts",
    "src/components/inline-tools/inline-tool-marker.ts",
    "src/components/modules/api/blocks.ts",
    "src/components/modules/blockManager/blockManager.ts",
    "src/components/modules/blockManager/yjs-sync.ts",
    "src/components/modules/collaboration/presence-avatars.ts",
    "src/components/modules/collaboration/presence-carets.ts",
    "src/components/modules/collaboration/presence-renderer.ts",
    "src/components/modules/collaboration/presence.ts",
    "src/components/modules/collaboration/provider.ts",
    "src/components/modules/modificationsObserver.ts",
    "src/components/modules/readonly.ts",
    "src/components/modules/saver.ts",
    "src/components/modules/toolbar/blockSettings.ts",
    "src/components/modules/toolbar/index.ts",
    "src/components/modules/toolbar/inline/index.ts",
    "src/components/modules/toolbar/inline/keyboard-handler.ts",
    "src/components/modules/toolbar/inline/positioner.ts",
    "src/components/modules/tools.ts",
    "src/components/modules/ui.ts",
    "src/components/modules/uiControllers/controllers/keyboard.ts",
    "src/components/modules/yjs/document-store.ts",
    "src/components/modules/yjs/undo-history.ts",
    "src/components/shared/block-color.ts",
    "src/components/shared/color-picker.ts",
    "src/components/utils/asset-uploader.ts",
    "src/components/utils/convert-menu.ts",
    "src/components/utils/modal-dialog.ts",
    "src/components/utils/orphan-sweep.ts",
    "src/components/utils/persistence.ts",
    "src/components/utils/popover/components/popover-item/popover-item-default/popover-item-default.ts",
    "src/components/utils/popover/popover-desktop.ts",
    "src/components/utils/popover/popover-inline.ts",
    "src/components/utils/popover/popover-mobile.ts",
    "src/markdown/blocks-to-markdown.ts",
    "src/markdown/mdast-to-blocks.ts",
    "src/markdown/phrasing-to-html.ts",
    "src/playground/icon-gallery.ts",
    "src/tools/audio/uploader.ts",
    "src/tools/file/file-icon.ts",
    "src/tools/file/uploader.ts",
    "src/tools/image/ui.ts",
    "src/tools/image/uploader.ts",
    "src/tools/list/data-normalizer.ts",
    "src/tools/table/table-cell-selection.ts",
    "src/tools/video/controls.ts",
    "src/tools/video/uploader.ts",
    "src/view/blocks-to-markdown.ts",
    "src/view/blocks-to-plain-text.ts",
    "src/view/document-texts.ts"
  ]
}
