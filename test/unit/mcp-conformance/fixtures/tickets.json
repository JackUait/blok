    {
      "name": "ticket URL: a matching ticket reaches the room, which refuses the upgrade",
      "argv": [
        "--sync-url",
        "${hostWs}/sync",
        "--ticket-url",
        "${host}/tickets",
        "--origin",
        "http://app.test"
      ],
      "env": {
        "BLOK_MCP_HOST_TOKEN": "host-token-1"
      },
      "hosts": {
        "POST /tickets": {
          "status": 200,
          "json": {
            "ticket": {
              "$ticket": {
                "claims": {
                  "user": "agent:local:tix",
                  "doc": "doc",
                  "write": true
                },
                "expiresIn": 1800
              }
            }
          }
        },
        "$upgradeStatus": 403
      },
      "hostRequestOrder": "distinct",
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": true
              }
            }
          },
          "capture": {
            "h11": {
              "pointer": "/result/structuredContent/handle",
              "optional": true
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "ROOM_SYNC_TIMEOUT",
                  "message": "The room did not finish loading in time. Try again.",
                  "retryable": true
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        }
      ],
      "expectExit": {
        "code": 0
      },
      "expectHostRequests": [
        {
          "method": "POST",
          "path": "/tickets",
          "headers": {
            "authorization": "Bearer host-token-1",
            "content-type": "application/json"
          },
          "body": {
            "doc": "doc",
            "write": true,
            "principal": "local",
            "clientName": "tix",
            "actorId": "agent:local:tix"
          }
        },
        {
          "method": "GET",
          "path": "/sync/doc",
          "headers": {
            "origin": "http://app.test",
            "sec-websocket-protocol": [
              "blok-sync.v2",
              "blok-sync.v1",
              {
                "$jwt": {
                  "headerBytes": "{\"alg\":\"HS256\",\"typ\":\"JWT\"}",
                  "header": {
                    "alg": "HS256",
                    "typ": "JWT"
                  },
                  "payload": {
                    "user": "agent:local:tix",
                    "doc": "doc",
                    "write": true,
                    "exp": "<exp>"
                  }
                }
              }
            ]
          }
        }
      ]
    },
