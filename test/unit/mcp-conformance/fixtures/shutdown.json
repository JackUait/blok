{
  "description": "Stopping: SIGTERM and SIGINT over stdio and HTTP, a save in flight when the signal comes, the 45 s stop deadline, and a second signal during a stop.",
  "defaults": {
    "transport": "stdio",
    "argv": [
      "--source",
      "files:${dir}"
    ],
    "files": {
      "doc.json": {
        "json": {
          "title": "Notes",
          "blocks": [
            {
              "id": "p1",
              "type": "paragraph",
              "data": {
                "text": "Hello"
              }
            }
          ]
        }
      },
      "other.json": {
        "json": {
          "blocks": []
        }
      }
    },
    "session": {
      "protocolVersion": "2025-11-25"
    },
    "maskKeys": [
      "lastEditedAt",
      "savedVersion",
      "revision"
    ]
  },
  "cases": [
    {
      "name": "stdio: SIGTERM while idle",
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": true
              }
            }
          },
          "capture": {
            "handle": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${handle}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 600000,
                "contractRevision": "${contractRevision}",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "signal": "SIGTERM",
          "expect": {
            "code": 0
          }
        }
      ],
      "expectExit": {
        "code": 0
      }
    },
