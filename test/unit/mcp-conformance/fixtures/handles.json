    {
      "argv": [
        "--source",
        "endpoint:${host}/docs",
        "--max-handles",
        "2"
      ],
      "name": "a cancelled open sends no answer and keeps no handle",
      "env": {
        "BLOK_DOC_ENDPOINT_AUTH": "Token t"
      },
      "hosts": {
        "GET /docs/a": {
          "status": 200,
          "json": {
            "data": {
              "blocks": []
            },
            "version": "v1"
          },
          "delayMs": 1500
        },
        "GET /docs/b": {
          "status": 200,
          "json": {
            "data": {
              "blocks": []
            },
            "version": "v1"
          }
        },
        "GET /docs/c": {
          "status": 200,
          "json": {
            "data": {
              "blocks": []
            },
            "version": "v1"
          }
        }
      },
      "steps": [
        {
          "send": {
            "id": 77,
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "a"
              }
            }
          },
          "noAnswer": true
        },
        {
          "notify": {
            "method": "notifications/cancelled",
            "params": {
              "requestId": 77,
              "reason": "changed my mind"
            }
          },
          "afterHost": "GET /docs/a"
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "b"
              }
            }
          },
          "capture": {
            "b": "/result/structuredContent/handle"
