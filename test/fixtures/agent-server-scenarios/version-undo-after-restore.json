{
  "name": "version-undo-after-restore",
  "room": {},
  "seed": {
    "blocks": [
      {
        "id": "p",
        "type": "paragraph",
        "data": {
          "text": "Hello world"
        }
      },
      {
        "id": "q",
        "type": "paragraph",
        "data": {
          "text": "Second"
        }
      }
    ]
  },
  "steps": [
    {
      "run": "room",
      "actor": {
        "id": "agent-cs",
        "name": "Agent"
      },
      "batch": {
        "commands": [
          {
            "name": "text.replace",
            "args": {
              "id": "p",
              "with": "Changed"
            }
          }
        ]
      },
      "expect": {
        "ok": true
      }
    },
    {
      "run": "room",
      "actor": {
        "id": "agent-cs",
        "name": "Agent"
      },
      "batch": {
        "commands": [
          {
            "name": "history.restore",
            "args": {
              "version": "{lineage}:0"
            }
          }
        ]
      },
      "expect": {
        "ok": true
      }
    },
    {
      "run": "room",
      "actor": {
        "id": "agent-cs",
        "name": "Agent"
      },
      "batch": {
        "commands": [
          {
            "name": "history.undo",
            "args": {}
          }
        ]
      },
      "expect": {
        "ok": false,
        "code": "NOTHING_TO_UNDO",
        "committed": 0,
        "state": {
          "/blocks/0/data/text/0/text": "Hello world"
        }
      }
    }
  ]
}
