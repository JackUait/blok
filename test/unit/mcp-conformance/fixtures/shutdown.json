      "name": "stdio: a second SIGTERM during a held stop ends the process at once",
      "hosts": {
        "GET /docs/doc": {
          "stall": true
        }
      },
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
