{
  "description": "Sub-pages under --page-titles page-map: page.rename and page.setIcon write the page's own document, and inserting a page block creates one. Refusals come back inside the batch result.",
  "defaults": {
    "transport": "stdio",
    "argv": [
      "--source",
      "files:${dir}",
      "--page-titles",
      "page-map"
    ],
    "session": {
      "protocolVersion": "2025-11-25"
    },
    "maskKeys": [
      "lastEditedAt",
      "savedVersion",
      "revision"
    ]
  },
  "cases": [
    {
      "name": "stored: page.rename writes the title into the page's own document",
      "files": {
        "parent.json": {
          "json": {
            "blocks": [
              {
                "id": "pb",
                "type": "page",
                "data": {
                  "pageId": "child"
                }
              }
            ]
          }
        },
        "child.json": {
          "json": {
            "blocks": [],
            "title": "Old"
          }
        }
      },
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "parent",
                "write": true
              }
            }
          },
          "capture": {
            "handle": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${handle}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 600000,
                "contractRevision": "0a086976",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_execute",
              "arguments": {
                "handle": "${handle}",
                "commands": [
                  {
                    "name": "page.rename",
                    "args": {
                      "id": "pb",
                      "title": "New name"
                    }
                  }
                ]
              }
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "ok": true,
                "revision": "<masked>",
                "results": [
                  {
                    "pageId": "child",
                    "applied": true
                  }
                ],
                "delivery": {
                  "durable": false,
                  "pending": false,
                  "serverSequence": null,
                  "savedVersion": null
                }
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 2
          }
        }
      ],
      "watchFiles": [
        "parent.json",
        "child.json"
      ],
      "expectExit": {
        "code": 0
      },
      "expectFiles": {
        "parent.json": {
          "text": "{\"blocks\":[{\"id\":\"pb\",\"type\":\"page\",\"data\":{\"pageId\":\"child\"}}]}"
        },
        "child.json": {
          "text": "{\n  \"title\": \"New name\",\n  \"blocks\": []\n}\n"
        }
      }
    },
