[
  {
    "name": "blok_read",
    "description": "Read the document as a tree of blocks with ids, types and text. Read before you edit, and again after a STALE error.",
    "input_schema": {
      "type": "object",
      "properties": {
        "rootId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "A block id, or \"$\" plus the ref of a block an earlier command created."
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A block id, or \"$\" plus the ref of a block an earlier command created."
          }
        },
        "detail": {
          "enum": [
            "outline",
            "full"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        },
        "textLimit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "blok_describe",
    "description": "Look up what you can do. With no arguments it lists tools and commands. Pass { tool } or { command } to get the argument schema.",
    "input_schema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "blok_execute",
    "description": "Run a batch of commands. Either all of them land or none do. Use block ids from blok_read. To add several text blocks at once (headings, paragraphs, lists, code), use one markdown.insert. The schema has the full arguments for block.convert, block.delete, block.insert, block.move, doc.setIcon, doc.setTitle, markdown.insert, text.format, text.replace. Call blok_describe for any other command's arguments. Its result lists the changed blocks with their data as they now read, so you can check your work without blok_read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.convert"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A block tool: paragraph, header, list, toggle, callout, quote, code. A variant sets these data fields; the tool's other required fields still go in data: header {level: 1|2|3|4|5|6, isToggleable: true}, list {style: \"unordered\"|\"ordered\"|\"checklist\"}."
                      },
                      "data": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "id",
                      "type"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.delete"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.insert"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A block tool: paragraph, header, list, table, toggle, callout, database, database-row, divider, spacer, table_of_contents, quote, code, image, file, audio, video, column_list, column, tabs, tab, embed, bookmark, page, page-link, rating. A variant sets these data fields; the tool's other required fields still go in data: header {level: 1|2|3|4|5|6, isToggleable: true}, list {style: \"unordered\"|\"ordered\"|\"checklist\"}."
                      },
                      "data": {
                        "type": "object",
                        "description": "Rich-text fields take what text.replace \"with\" takes."
                      },
                      "tunes": {
                        "type": "object"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "children": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/block_insert__insertSpec"
                        }
                      },
                      "parentId": {
                        "$ref": "#/$defs/parentId"
                      },
                      "position": {
                        "$ref": "#/$defs/position"
                      },
                      "demote": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "block.move"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "parentId": {
                        "$ref": "#/$defs/parentId"
                      },
                      "position": {
                        "$ref": "#/$defs/position"
                      }
                    },
                    "required": [
                      "id",
                      "position"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "doc.setIcon"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "icon": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "emoji"
                              },
                              "value": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "value"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "const": "image"
                              },
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "url"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "icon"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "doc.setTitle"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "markdown.insert"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "markdown": {
                        "type": "string",
                        "description": "Gives bold, italic, strikethrough, inline code and links. Markdown has no syntax for underline, sup, sub, highlight or colours, and their HTML stays literal: set them with text.format. Call describe({ command: 'markdown.insert' }) for the rest."
                      },
                      "parentId": {
                        "$ref": "#/$defs/parentId"
                      },
                      "position": {
                        "$ref": "#/$defs/position"
                      }
                    },
                    "required": [
                      "markdown"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "text.format"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "field": {
                        "type": "string"
                      },
                      "range": {
                        "$ref": "#/$defs/range"
                      },
                      "set": {
                        "$ref": "#/$defs/marks"
                      },
                      "unset": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "To remove a mark, list it here. \"*\" clears all, \"tag:*\" custom marks; set then applies."
                      }
                    },
                    "required": [
                      "id",
                      "range"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "text.replace"
                  },
                  "args": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "field": {
                        "type": "string"
                      },
                      "range": {
                        "$ref": "#/$defs/range"
                      },
                      "with": {
                        "description": "Plain text (HTML tags stay literal), or rich-text segments. Never Markdown.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "required": [
                                    "text"
                                  ],
                                  "additionalProperties": false,
                                  "properties": {
                                    "text": {
                                      "type": "string",
                                      "description": "Line breaks are \"\\n\"."
                                    },
                                    "marks": {
                                      "$ref": "#/$defs/marks"
                                    }
                                  }
                                },
                                {
                                  "type": "object",
                                  "required": [
                                    "embed"
                                  ],
                                  "additionalProperties": false,
                                  "properties": {
                                    "embed": {
                                      "oneOf": [
                                        {
                                          "type": "object",
                                          "required": [
                                            "equation"
                                          ],
                                          "additionalProperties": false,
                                          "properties": {
                                            "equation": {
                                              "type": "object",
                                              "required": [
                                                "expression"
                                              ],
                                              "additionalProperties": false,
                                              "properties": {
                                                "expression": {
                                                  "type": "string",
                                                  "description": "LaTeX."
                                                }
                                              }
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": [
                                            "page"
                                          ],
                                          "additionalProperties": false,
                                          "properties": {
                                            "page": {
                                              "type": "object",
                                              "required": [
                                                "id"
                                              ],
                                              "additionalProperties": false,
                                              "properties": {
                                                "id": {
                                                  "type": "string"
                                                }
                                              }
                                            }
                                          }
                                        },
                                        {
                                          "type": "object",
                                          "required": [
                                            "html"
                                          ],
                                          "additionalProperties": false,
                                          "properties": {
                                            "html": {
                                              "type": "string",
                                              "description": "Kept verbatim."
                                            }
                                          }
                                        }
                                      ]
                                    },
                                    "marks": {
                                      "$ref": "#/$defs/marks"
                                    }
                                  }
                                },
                                {
                                  "type": "object"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "with"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "audio.setCover",
                      "audio.setSource",
                      "block.duplicate",
                      "block.update",
                      "bookmark.create",
                      "column_list.addColumn",
                      "column_list.create",
                      "column_list.removeColumn",
                      "column_list.setWidths",
                      "database.addOption",
                      "database.addProperty",
                      "database.addRow",
                      "database.addTemplate",
                      "database.addView",
                      "database.changePropertyType",
                      "database.create",
                      "database.deleteOption",
                      "database.deleteProperty",
                      "database.deleteView",
                      "database.duplicateProperty",
                      "database.duplicateView",
                      "database.moveOption",
                      "database.moveRow",
                      "database.moveView",
                      "database.recolorOption",
                      "database.renameOption",
                      "database.renameView",
                      "database.setDefaultTemplate",
                      "database.setLayout",
                      "database.setLock",
                      "database.setRowValues",
                      "database.setTemplateRepeat",
                      "database.updateProperty",
                      "database.updateView",
                      "doc.find",
                      "doc.read",
                      "embed.create",
                      "embed.setUrl",
                      "file.setSource",
                      "history.redo",
                      "history.undo",
                      "image.addMarkup",
                      "image.crop",
                      "image.flip",
                      "image.removeMarkup",
                      "image.rotate",
                      "image.setSource",
                      "image.straighten",
                      "image.updateMarkup",
                      "markdown.export",
                      "rating.setValue",
                      "table.clearCells",
                      "table.create",
                      "table.deleteColumns",
                      "table.deleteRows",
                      "table.duplicateColumns",
                      "table.duplicateRows",
                      "table.fillCells",
                      "table.insertColumns",
                      "table.insertRows",
                      "table.mergeCells",
                      "table.moveColumn",
                      "table.moveRow",
                      "table.splitCell",
                      "table.styleCells",
                      "tabs.addTab",
                      "tabs.create",
                      "tabs.deleteTab",
                      "text.delete",
                      "text.insert",
                      "video.setSource"
                    ]
                  },
                  "args": {
                    "type": "object"
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "args"
                ]
              }
            ]
          }
        },
        "expectRevision": {
          "type": "string"
        }
      },
      "required": [
        "commands"
      ],
      "$defs": {
        "block_insert__insertSpec": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "object"
            },
            "tunes": {
              "type": "object"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Later commands use this id as is, no \"$\"."
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block_insert__insertSpec"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "marks": {
          "type": "object",
          "description": "Formatting on one run. Unknown keys drop, except custom `tag:<name>` marks.",
          "properties": {
            "bold": {
              "const": true
            },
            "italic": {
              "const": true
            },
            "underline": {
              "const": true
            },
            "strikethrough": {
              "const": true
            },
            "code": {
              "const": true
            },
            "sup": {
              "const": true,
              "description": "Not with sub on one run."
            },
            "sub": {
              "const": true
            },
            "highlight": {
              "const": true,
              "description": "Stored as background \"yellow\" unless background is set."
            },
            "color": {
              "type": "string",
              "description": "\"gray\", \"brown\", \"orange\", \"yellow\", \"green\", \"blue\", \"purple\", \"pink\", \"red\". Hex, rgb, hsl snap to the nearest; names and var() stay; other syntaxes drop."
            },
            "background": {
              "type": "string",
              "description": "Like color; page backgrounds drop."
            },
            "link": {
              "type": "object",
              "description": "Default \"_blank\"/\"nofollow\", \"_self\" for #anchors.",
              "required": [
                "href"
              ],
              "additionalProperties": false,
              "properties": {
                "href": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "rel": {
                  "type": "string"
                }
              }
            }
          },
          "patternProperties": {
            "^tag:": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "position": {
          "description": "'start' | 'end' | { before: id } | { after: id }",
          "oneOf": [
            {
              "enum": [
                "start",
                "end"
              ]
            },
            {
              "type": "object",
              "properties": {
                "before": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "before"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "after": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "after"
              ],
              "additionalProperties": false
            }
          ]
        },
        "range": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "expectText": {
                  "type": "string"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "find": {
                  "type": "string",
                  "minLength": 1
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1
                },
                "matchCase": {
                  "type": "boolean"
                },
                "wholeWord": {
                  "type": "boolean"
                },
                "all": {
                  "type": "boolean"
                }
              },
              "required": [
                "find"
              ],
              "additionalProperties": false
            }
          ]
        },
        "parentId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "A block id, or \"$\" plus the ref of a block an earlier command created."
        }
      }
    }
  }
]