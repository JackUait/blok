    {
      "argv": [
        "--source",
        "endpoint:${host}/docs"
      ],
      "name": "stdio: a save in flight at SIGTERM is finished and answered before the exit",
      "env": {
        "BLOK_DOC_ENDPOINT_AUTH": "Token t"
      },
      "hosts": {
        "GET /docs/doc": {
          "status": 200,
          "json": {
            "data": {
              "blocks": []
            },
            "version": "v1"
          }
        },
        "PUT /docs/doc": {
          "status": 200,
          "json": {
            "version": "v2"
          },
          "delayMs": 1500
        }
      },
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": true
              }
            }
          },
          "capture": {
            "handle": "/result/structuredContent/handle"
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "handle": "${handle}",
                "mode": "stored",
                "write": true,
                "durability": "saved-on-execute",
                "expiresAfterIdleMs": 600000,
                "contractRevision": "${contractRevision}",
                "exists": true
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_execute",
              "arguments": {
                "handle": "${handle}",
                "commands": [
                  {
                    "name": "doc.setTitle",
                    "args": {
                      "title": "Kept"
                    }
                  }
                ]
              }
            }
          },
          "signal": "SIGTERM",
          "signalWhenHost": "PUT /docs/doc",
          "minElapsedMs": 1400,
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "ok": true,
                "revision": "<masked>",
                "results": [
                  {}
                ],
                "delivery": {
                  "durable": true,
                  "pending": false,
                  "serverSequence": null,
                  "savedVersion": "<masked>"
                }
              },
              "isError": false
            },
            "jsonrpc": "2.0",
            "id": 2
          }
        }
      ],
      "expectExit": {
        "code": 0
      },
      "expectHostRequests": [
        {
          "method": "GET",
          "path": "/docs/doc",
          "headers": {
            "authorization": "Token t"
          }
        },
        {
          "method": "PUT",
          "path": "/docs/doc",
          "headers": {
            "authorization": "Token t",
            "content-type": "application/json",
            "blok-doc-version": "v1"
          },
          "body": {
            "title": "Kept",
            "blocks": []
          }
        }
      ]
    },
