[
  {
    "name": "blok_read",
    "description": "Read the document as a tree of blocks with ids, types and text. Read before you edit, and again after a STALE error.",
    "input_schema": {
      "type": "object",
      "properties": {
        "rootId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "A block id, or \"$\" plus the ref of a block an earlier command created."
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A block id, or \"$\" plus the ref of a block an earlier command created."
          }
        },
        "detail": {
          "enum": [
            "outline",
            "full"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        },
        "textLimit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "blok_describe",
    "description": "Look up what you can do. With no arguments it lists tools and commands. Pass { tool } or { command } to get the argument schema.",
    "input_schema": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "blok_execute",
    "description": "Run a batch of commands. Either all of them land or none do. Use block ids from blok_read. To add several text blocks at once (headings, paragraphs, lists, code), use one markdown.insert. Call blok_describe for a command's arguments. Its result lists the changed blocks with their data as they now read, so you can check your work without blok_read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "audio.setCover",
                  "audio.setSource",
                  "block.convert",
                  "block.delete",
                  "block.duplicate",
                  "block.insert",
                  "block.move",
                  "block.update",
                  "bookmark.create",
                  "column_list.addColumn",
                  "column_list.create",
                  "column_list.removeColumn",
                  "column_list.setWidths",
                  "database.addComment",
                  "database.addOption",
                  "database.addProperty",
                  "database.addRow",
                  "database.addTemplate",
                  "database.addView",
                  "database.applyTemplate",
                  "database.changePropertyType",
                  "database.create",
                  "database.deleteComment",
                  "database.deleteOption",
                  "database.deleteProperty",
                  "database.deleteRow",
                  "database.deleteView",
                  "database.duplicateProperty",
                  "database.duplicateRow",
                  "database.duplicateView",
                  "database.editComment",
                  "database.moveOption",
                  "database.moveRow",
                  "database.moveRowTo",
                  "database.moveView",
                  "database.recolorOption",
                  "database.renameOption",
                  "database.renameView",
                  "database.replyToComment",
                  "database.resolveComment",
                  "database.setDefaultTemplate",
                  "database.setLayout",
                  "database.setLock",
                  "database.setRowValues",
                  "database.setTemplateRepeat",
                  "database.updateProperty",
                  "database.updateView",
                  "doc.find",
                  "doc.read",
                  "doc.setIcon",
                  "doc.setTitle",
                  "embed.create",
                  "embed.setUrl",
                  "file.setSource",
                  "history.redo",
                  "history.undo",
                  "html.insert",
                  "image.addMarkup",
                  "image.crop",
                  "image.flip",
                  "image.removeMarkup",
                  "image.rotate",
                  "image.setSource",
                  "image.straighten",
                  "image.updateMarkup",
                  "markdown.export",
                  "markdown.insert",
                  "rating.setValue",
                  "table.clearCells",
                  "table.create",
                  "table.deleteColumns",
                  "table.deleteRows",
                  "table.duplicateColumns",
                  "table.duplicateRows",
                  "table.fillCells",
                  "table.insertColumns",
                  "table.insertRows",
                  "table.mergeCells",
                  "table.moveColumn",
                  "table.moveRow",
                  "table.splitCell",
                  "table.styleCells",
                  "tabs.addTab",
                  "tabs.create",
                  "tabs.deleteTab",
                  "text.delete",
                  "text.format",
                  "text.insert",
                  "text.replace",
                  "video.setSource"
                ]
              },
              "args": {
                "type": "object"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "args"
            ]
          }
        },
        "expectRevision": {
          "type": "string"
        }
      },
      "required": [
        "commands"
      ]
    }
  }
]