{
  "segments": [
    { "name": "adjacent-plain-runs-merge", "input": [{ "text": "a" }, { "text": "b" }] },
    { "name": "empty-runs-dropped", "input": [{ "text": "" }, { "text": "a", "marks": { "bold": true } }, { "text": "" }] },
    { "name": "mark-order", "input": [{ "text": "x", "marks": { "sub": true, "bold": true, "link": { "href": "h" }, "color": "red", "background": "blue", "highlight": true, "italic": true, "underline": true, "strikethrough": true, "code": true, "sup": true } }] },
    { "name": "link-null-is-absent", "input": [{ "text": "x", "marks": { "link": null, "bold": true } }] },
    { "name": "link-without-href-dropped", "input": [{ "text": "x", "marks": { "link": { "target": "_blank" } } }] },
    { "name": "link-href-not-string-dropped", "input": [{ "text": "x", "marks": { "link": { "href": 5 } } }] },
    { "name": "link-key-order-and-extra-keys", "input": [{ "text": "x", "marks": { "link": { "rel": "noopener", "title": "t", "href": "h", "target": "_blank" } } }] },
    { "name": "link-non-string-target-dropped", "input": [{ "text": "x", "marks": { "link": { "href": "h", "target": 1, "rel": null } } }] },
    { "name": "boolean-false-is-absent", "input": [{ "text": "x", "marks": { "bold": false, "italic": true } }] },
    { "name": "boolean-non-true-is-absent", "input": [{ "text": "x", "marks": { "highlight": "yes", "code": 1 } }] },
    { "name": "all-off-marks-drop-the-key", "input": [{ "text": "x", "marks": { "bold": false, "link": null } }] },
    { "name": "empty-marks-object-dropped", "input": [{ "text": "x", "marks": {} }] },
    { "name": "null-color-is-absent", "input": [{ "text": "x", "marks": { "color": null, "background": "blue" } }] },
    { "name": "non-string-color-kept", "input": [{ "text": "x", "marks": { "color": 5 } }] },
    { "name": "tag-record-keys-sorted", "input": [{ "text": "x", "marks": { "tag:abbr": { "title": "x", "class": "y" } } }] },
    { "name": "tag-record-null-member-kept", "input": [{ "text": "x", "marks": { "tag:abbr": { "title": null, "data-a": "1" } } }] },
    { "name": "tag-non-record-kept", "input": [{ "text": "x", "marks": { "tag:x": "str" } }] },
    { "name": "tag-null-is-absent", "input": [{ "text": "x", "marks": { "tag:x": null, "bold": true } }] },
    { "name": "unknown-keys-sorted-after-known", "input": [{ "text": "x", "marks": { "zeta": 1, "tag:b": { "a": "1" }, "alpha": "a", "bold": true, "Beta": true, "tag:a": {} } }] },
    { "name": "unknown-null-dropped", "input": [{ "text": "x", "marks": { "foo": null, "bold": true } }] },
    { "name": "integer-like-keys-js-order", "input": [{ "text": "x", "marks": { "10": 1, "9": 2, "b": 3, "tag:t": { "z": "1", "2": "a", "10": "b" } } }] },
    { "name": "nested-key-order-does-not-split-runs", "input": [{ "text": "a", "marks": { "link": { "href": "h", "target": "t" } } }, { "text": "b", "marks": { "link": { "target": "t", "href": "h" } } }] },
    { "name": "tag-record-order-does-not-split-runs", "input": [{ "text": "a", "marks": { "tag:x": { "b": "1", "a": "2" } } }, { "text": "b", "marks": { "tag:x": { "a": "2", "b": "1" } } }] },
    { "name": "unknown-object-order-does-not-split-runs", "input": [{ "text": "a", "marks": { "foo": { "b": 1, "a": [1, { "y": 1, "x": 2 }] } } }, { "text": "b", "marks": { "foo": { "a": [1, { "x": 2, "y": 1 }], "b": 1 } } }] },
    { "name": "different-marks-do-not-merge", "input": [{ "text": "a", "marks": { "bold": true } }, { "text": "b", "marks": { "bold": true, "italic": true } }, { "text": "c" }] },
    { "name": "merged-run-keeps-first-spelling", "input": [{ "text": "a", "marks": { "foo": { "b": 1, "a": 2 } } }, { "text": "b", "marks": { "foo": { "a": 2, "b": 1 } } }] },
    { "name": "embed-between-text", "input": [{ "text": "a" }, { "embed": { "equation": { "expression": "x^2" } } }, { "text": "b" }] },
    { "name": "embeds-never-merge", "input": [{ "embed": { "page": { "id": "p" } } }, { "embed": { "page": { "id": "p" } } }] },
    { "name": "embed-with-marks", "input": [{ "embed": { "html": "<img src=\"x.png\">" }, "marks": { "italic": true, "bold": true } }, { "text": "b", "marks": { "bold": true } }] },
    { "name": "newlines-and-markup-characters-stay-text", "input": [{ "text": "a < b && \"c\"\n" }, { "text": "<b>x</b>", "marks": { "code": true } }] },
    { "name": "marks-key-before-text-key", "input": [{ "marks": { "bold": true }, "text": "a" }] },
    { "name": "empty", "input": [] }
  ],
  "deltas": [
    { "name": "string-runs-with-equal-marks-merge", "input": [{ "insert": "ab", "attributes": { "bold": true } }, { "insert": "c", "attributes": { "bold": true } }, { "insert": "d" }] },
    { "name": "embed-object-reads-as-embed", "input": [{ "insert": "a" }, { "insert": { "page": { "id": "p" } }, "attributes": { "italic": true } }, { "insert": "b" }] },
    { "name": "non-object-inserts-skipped", "input": [{ "insert": "a" }, { "insert": [1, 2] }, { "insert": 5 }, { "insert": null }, { "insert": true }, { "insert": "b" }] },
    { "name": "empty-attributes-is-unmarked", "input": [{ "insert": "a", "attributes": {} }, { "insert": "b" }] },
    { "name": "stored-sorted-link-reads-canonical", "input": [{ "insert": "a", "attributes": { "link": { "href": "h", "rel": "r", "target": "t" } } }] },
    { "name": "foreign-false-mark-reads-absent", "input": [{ "insert": "a", "attributes": { "bold": false } }, { "insert": "b" }] }
  ]
}
