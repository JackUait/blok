    {
      "transport": "http",
      "argv": [
        "--http",
        "127.0.0.1:0",
        "--source",
        "files:${dir}",
        "--authorize",
        "${host}/authorize"
      ],
      "name": "http: SIGTERM while idle",
      "hosts": {
        "POST /authorize": {
          "status": 200,
          "json": {
            "allowed": true
          }
        }
      },
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_read",
              "arguments": {
                "handle": "nothing"
              }
            }
          },
          "expectHttp": {
            "status": 200,
            "contentType": "text/event-stream",
            "headers": {
              "allow": null,
              "www-authenticate": null,
              "mcp-session-id": null,
              "access-control-allow-origin": null
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "UNKNOWN_HANDLE",
                  "message": "No open document has this handle. It may have expired; call blok_open again.",
                  "retryable": false
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        },
        {
          "signal": "SIGTERM",
          "expect": {
            "code": 0
          }
        }
      ],
      "expectHostRequests": []
    },
