{
  "description": "Room tickets: secret mode (BLOK_SECRET) and ticket URL mode against the harness's ticket route. The fake room refuses every WebSocket upgrade, so these cases stop at the room's door; LIVE mode itself is live.test.ts.",
  "defaults": {
    "transport": "stdio",
    "session": {
      "protocolVersion": "2025-11-25",
      "clientName": "tix"
    }
  },
  "cases": [
    {
      "name": "ticket URL: 401 refuses the host token, retryable",
      "argv": [
        "--sync-url",
        "${hostWs}/sync",
        "--ticket-url",
        "${host}/tickets",
        "--origin",
        "http://app.test"
      ],
      "env": {
        "BLOK_MCP_HOST_TOKEN": "host-token-1"
      },
      "hosts": {
        "POST /tickets": {
          "status": 401
        }
      },
      "steps": [
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_open",
              "arguments": {
                "documentId": "doc",
                "write": false
              }
            }
          },
          "capture": {
            "h1": {
              "pointer": "/result/structuredContent/handle",
              "optional": true
            }
          },
          "expect": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "json": "<same as structuredContent>"
                }
              ],
              "structuredContent": {
                "error": {
                  "code": "SOURCE_UNAVAILABLE",
                  "message": "The ticket endpoint refused the host token.",
                  "retryable": true
                }
              },
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 1
          }
        }
      ],
      "expectExit": {
        "code": 0
      },
      "expectHostRequests": [
        {
          "method": "POST",
          "path": "/tickets",
          "headers": {
            "authorization": "Bearer host-token-1",
            "content-type": "application/json"
          },
          "body": {
            "doc": "doc",
            "write": false,
            "principal": "local",
            "clientName": "tix",
            "actorId": "agent:local:tix"
          }
        }
      ]
    },
