{
  "name": "@bloklabs/server",
  "version": "1.12.0",
  "description": "Blok server delivery for ASP.NET Core, npm, and Docker — shared C# routes for file uploads and link previews.",
  "license": "Apache-2.0",
  "author": "JackUait",
  "homepage": "https://blokeditor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackUait/blok.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/JackUait/blok/issues"
  },
  "keywords": [
    "blok",
    "block-editor",
    "rich-text-editor",
    "file-upload",
    "uploads",
    "link-preview",
    "unfurl",
    "open-graph",
    "server",
    "sidecar",
    "ssrf"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ticket": {
      "types": "./types/index.d.ts",
      "import": "./dist/ticket.mjs",
      "require": "./dist/ticket.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "blok-server": "bin/blok-server.mjs"
  },
  "files": [
    "bin",
    "dist",
    "types"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn run -T vite build --mode production",
    "test": "yarn run -T vitest run"
  }
}
