                    "args": {
                      "title": "First"
                    }
                  }
                ]
              }
            }
          },
          "noAnswer": true
        },
        {
          "send": {
            "method": "tools/call",
            "params": {
              "name": "blok_execute",
              "arguments": {
                "handle": "${handle}",
                "commands": [
                  {
                    "name": "doc.setTitle",
                    "args": {
                      "title": "Second"
                    }
                  }
