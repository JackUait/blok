<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <PackageId>Blok.Server</PackageId>
    <Authors>JackUait</Authors>
    <Description>Shared server services and embedded document runtime for Blok.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://blokeditor.com</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JackUait/blok.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Jint" Version="4.16.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generated/blok-server-runtime.js"
                      LogicalName="Blok.Server.Runtime.blok-server-runtime.js" />
  </ItemGroup>

  <Target Name="BuildBlokServerRuntime" BeforeTargets="PrepareResourceNames">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)../../../../scripts/build-server-runtime.mjs&quot;" />
  </Target>
</Project>
