<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BlokServerVersion Condition="'$(BlokServerVersion)' == ''">dev</BlokServerVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BlokServerVersion" Value="$(BlokServerVersion)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Blok.Server.AspNetCore/Blok.Server.AspNetCore.csproj"
                      GlobalPropertiesToRemove="AssemblyName" />
  </ItemGroup>
</Project>
